{
  "name": "lincx-mcp-server",
  "version": "1.0.0",
  "description": "Lincx MCP server — browser login UI, wrapped-token auth, multi-network support",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "lint": "standard src/ scripts/",
    "lint:fix": "standard --fix src/ scripts/",
    "dev": "node scripts/dev-tunnel.mjs",
    "dev:ngrok": "node scripts/dev-tunnel.mjs ngrok",
    "dev:cloudflared": "node scripts/dev-tunnel.mjs cloudflared",
    "dev:local": "node --watch --env-file=.env src/index.js",
    "test": "ava",
    "test:watch": "ava --watch",
    "smoke": "node scripts/smoke-prod.mjs",
    "soak": "node scripts/soak.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "http-hash-router": "^2.0.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "ava": "^6.4.1",
    "esmock": "^2.7.6",
    "puppeteer": "^25.10.0",
    "standard": "^17.1.2",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=22"
  },
  "ava": {
    "files": [
      "src/tests/**/*.test.js"
    ],
    "environmentVariables": {
      "NODE_ENV": "test",
      "WRAPPING_KEY": "test-wrapping-key-32chars-minimum!!"
    },
    "workerThreads": false,
    "timeout": "30s"
  }
}
