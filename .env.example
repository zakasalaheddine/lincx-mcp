# ── Required ──────────────────────────────────────────────────────────────────
# Work API base URL — all requests go here, including /api/networks
# networkId is appended as a query param automatically: ?networkId=svce6t
WORK_API_BASE_URL=http://localhost:3050

# ── Optional (defaults shown) ─────────────────────────────────────────────────
# Lincx identity server
IDENTITY_SERVER=https://ix-id.lincx.la

# Port for the Express login UI, health check, and the MCP /mcp endpoint
PORT=5001

# Redis connection string. `npm run dev` starts a Dockerized Redis (predev hook)
# and this URL points at it (password/port from docker-compose.override.yml).
# Leave empty to fall back to the in-memory store (sessions lost on restart).
REDIS_URL=redis://default:localdev@localhost:6379
