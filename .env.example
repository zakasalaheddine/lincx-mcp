# Environment variables for lincx-mcp-server
#
# Copy to `.env` for LOCAL development (git-ignored). `npm run dev` /
# `npm run dev:local` load it via --env-file=.env.
#
# In PRODUCTION (Coolify Docker Compose) you do NOT use this file — set the same
# vars in the resource's "Environment Variables" tab. Note: a var only reaches the
# container if it's referenced in docker-compose.yml's `app.environment:` list
# (WORK_API_BASE_URL, IDENTITY_SERVER, STATS_TOKEN, USAGE_EVENT_CAP are wired there).
#
# Every var below is read in src/constants.ts. Defaults shown are what the code
# falls back to when the var is unset.

# ── Required ──────────────────────────────────────────────────────────────────

# Work API base URL — every business tool + /api/networks goes here. networkId is
# appended automatically as a query param (?networkId=svce6t), never by the client.
# Local: point at your Work API. Prod example: https://api.lincx.com
WORK_API_BASE_URL=http://localhost:3050

# ── Optional — connection (defaults shown) ────────────────────────────────────

# Lincx identity server used for browser login (POST /auth/login). Override only
# if it moves. Default: https://ix-id.lincx.la
IDENTITY_SERVER=https://ix-id.lincx.la

# Express port — serves the login UI, /health, /stats, and the MCP /mcp endpoint.
# Default: 5001 (prod uses 3000, set in docker-compose.yml).
PORT=5001

# Public base URL used when building the browser login links returned to clients
# and the OAuth discovery metadata. Leave UNSET locally — it defaults to
# http://localhost:<PORT>. In prod Coolify sets it to the generated https domain.
# PUBLIC_BASE_URL=http://localhost:5001

# "production" disables the /dev/* debug routes. Default: development.
# NODE_ENV=development

# Redis connection string — persistent sessions + the usage-event log. `npm run dev`
# starts a Dockerized Redis (predev hook) that this URL points at. Leave EMPTY to
# use the in-memory store (sessions AND analytics lost on restart — dev only).
REDIS_URL=redis://default:localdev@localhost:6379

# ── Optional — usage analytics (GET /stats) ───────────────────────────────────

# Shared secret that gates GET /stats. Send it as `Authorization: Bearer <token>`
# (preferred) OR as a `?token=<token>` query param to open /stats directly in a
# browser. UNSET (the default) → /stats returns 404 and is fully disabled (never
# accidentally public). SET → 401 without the token, 200 with it. Use a long random
# value; generate one with:  openssl rand -hex 32
# NOTE: the ?token= form leaks the secret into browser history / access logs /
# Referer — prefer the header, and rotate STATS_TOKEN if a URL leaks.
# Do NOT commit the real value — set it here locally (untracked) or in Coolify.
STATS_TOKEN=

# Max usage events kept in the capped log (Redis list `usage:events`), and the
# default /stats window. Default: 50000 (~10–15 MB Redis). Lower to save memory,
# raise for longer history.
# USAGE_EVENT_CAP=50000
